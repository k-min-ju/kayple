[Unit]
Description=Kayple reservation API
After=network.target mysql.service

[Service]
User=ubuntu
EnvironmentFile=/etc/kayple.env
ExecStart=/usr/lib/jvm/java-25-openjdk-amd64/bin/java -Duser.timezone=Asia/Seoul -jar /opt/kayple/app.jar
Restart=on-failure
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
